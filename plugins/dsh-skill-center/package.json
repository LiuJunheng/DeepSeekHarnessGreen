{
  "name": "dsh-skill-center",
  "version": "0.2.3",
  "description": "技能中心：左侧技能入口 + 官方/个人技能分组管理 + 聊天栏技能选择器（无构建步骤、零依赖）",
  "license": "Apache-2.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": ["slots"],
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "plugin",
    "skill",
    "skills",
    "skill-center",
    "deepseek-harness"
  ]
}
