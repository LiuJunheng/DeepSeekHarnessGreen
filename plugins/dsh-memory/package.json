{
  "name": "dsh-memory",
  "version": "0.1.0",
  "description": "祖宗记忆库记忆插件: 自研 SQLite 引擎 + MCP stdio 桥 + 自动记忆钩子 + 记忆库管理卡片 UI。零外部 Python 依赖, 可插拔。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-session": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-system-prompt": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-tools": "0.1.2-alpha.4",
    "@deepseek-ai/schemastery": "3.18.2"
  },
  "files": [
    "lib",
    "engine",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "license": "Apache-2.0"
}
