# Python 缓存
__pycache__/
*.pyc
*.pyo

# 运行时目录（Node / Python / dsh / 日志 / 凭据等，全部为下载或生成的临时数据）
runtime/

# PyInstaller 打包产物
build/
dist/
*.spec

# 分发 zip（发到 GitHub Release 用，不提交进仓库）
DSH_Launcher_*.zip
DSH_Skill_*.zip
Skill-dsh-deploy-maintain.zip
python-tkinter-desktop-dev.zip

# 用户全局 gitignore 里的 *.exe 会拦截 DSH_Launcher.exe / DSH_Update.exe, 这里显式取消忽略:
# 与 Release 同源约定 (2026-08-17), exe 一键启动器要随仓库一起上传 GitHub。
!DSH_Launcher.exe
!DSH_Update.exe

# TRAE 内部工作区文件（设计草稿等，不进仓库）
.trae/

# 系统文件
Thumbs.db
Desktop.ini
.DS_Store

# 临时工作区（运行时生成的检查脚本等）
workspace/

# 内部文档 / 草稿（不进仓库，放个人记录、踩坑笔记、方案草稿）
doc/
